{
  "name": "construction-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --no-cache",
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo test -- --watch",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter=@construction/db prisma generate",
    "db:migrate": "pnpm --filter=@construction/db prisma migrate deploy",
    "db:studio": "pnpm --filter=@construction/db prisma studio",
    "db:seed": "pnpm --filter=@construction/db seed",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "turbo": "^1.10.16",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
